# Public browser configuration only. Values prefixed with VITE_ are bundled
# into the frontend and must never contain an Auth0 client secret.
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-single-page-application-client-id
VITE_AUTH0_CALLBACK_URL=http://localhost:5173/auth/callback

# Create an API in Auth0 and use its Identifier here. This is not a secret.
VITE_AUTH0_AUDIENCE=https://api.synex.app
